# Existing application configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# OpenAQ configuration
# Create an API key in your OpenAQ account. Do not commit the real value.
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org
OPENAQ_HTTP_TIMEOUT_SECONDS=30
OPENAQ_MAX_RETRIES=3
OPENAQ_RETRY_BACKOFF_SECONDS=1
OPENAQ_PAGE_LIMIT=100
OPENAQ_MAX_REQUEST_BUDGET=1000

# Delhi study region in decimal degrees (WGS84)
STUDY_REGION_SOUTH=28.40
STUDY_REGION_NORTH=28.90
STUDY_REGION_WEST=76.80
STUDY_REGION_EAST=77.35

# Air quality ingestion configuration
SUPPORTED_POLLUTANTS=pm25,pm10
AIR_QUALITY_HISTORICAL_START=2026-10-01
AIR_QUALITY_HISTORICAL_END=2026-11-01
INGESTION_BATCH_SIZE=500
AIR_QUALITY_FRESHNESS_SECONDS=3600
INCREMENTAL_OVERLAP_SECONDS=900
# JSON object; CO uses mg/m3 and all other limits use ug/m3.
AIR_QUALITY_HIGH_CONCENTRATION_LIMITS={"pm25":1000,"pm10":1000,"no2":2000,"so2":2000,"co":100,"o3":2500,"nh3":2000,"pb":30}
